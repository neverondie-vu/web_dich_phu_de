[{"start": "00:00:00.000", "end": "00:00:02.760", "text": "Giáp Đường bảo là đã tìm thấy một điểm đẹp."}, {"start": "00:00:02.760", "end": "00:00:03.760", "text": "Ở đó có nhiều nước đen."}, {"start": "00:00:03.760", "end": "00:00:05.440", "text": "Hôm trước, tôi đã thử vài lần rồi."}, {"start": "00:00:09.640", "end": "00:00:11.120", "text": "Có làm thì có hưởng mà."}, {"start": "00:00:11.120", "end": "00:00:12.120", "text": "Có một bức tường."}, {"start": "00:00:12.120", "end": "00:00:16.120", "text": "Đây là đội của người chơi Sơn Đông."}, {"start": "00:00:16.120", "end": "00:00:17.679", "text": "Đây là một pha nướng gắt hơn."}, {"start": "00:00:17.679", "end": "00:00:19.679", "text": "Cảm ơn."}, {"start": "00:00:20.960", "end": "00:00:22.600", "text": "Tôi đang nói về một quả trứng chim."}, {"start": "00:00:22.600", "end": "00:00:23.640", "text": "Quả trứng này to ghê."}, {"start": "00:00:23.640", "end": "00:00:25.679", "text": "Anh ấy đang làm việc."}, {"start": "00:00:25.679", "end": "00:00:27.280", "text": "Một cái cửa hàng thì không thể mất đi được."}, {"start": "00:00:27.280", "end": "00:00:28.039", "text": "Ồ, đó là..."}, {"start": "00:00:31.000", "end": "00:00:33.280", "text": "Hôm nay, một bộ thiết bị mới đã được phát triển."}, {"start": "00:00:34.480", "end": "00:00:35.799", "text": "Cựu đại úy Kawa."}]