[{"start": "00:00:00.000", "end": "00:00:02.760", "text": "Giáp Đường bảo là tìm được một điểm đánh dấu ngon rồi."}, {"start": "00:00:02.760", "end": "00:00:03.760", "text": "Ở đó có nhiều cá đen lắm."}, {"start": "00:00:03.760", "end": "00:00:05.440", "text": "Hôm trước tôi đã thử vài lượt rồi."}, {"start": "00:00:09.640", "end": "00:00:11.120", "text": "Có công thì phải có thưởng chứ."}, {"start": "00:00:11.120", "end": "00:00:12.120", "text": "Có một cái tường ở đó."}, {"start": "00:00:12.120", "end": "00:00:16.120", "text": "Cái này là của mấy ông chơi ở Sơn Đông."}, {"start": "00:00:16.120", "end": "00:00:17.679", "text": "Lần này nướng được hơn rồi."}, {"start": "00:00:17.679", "end": "00:00:19.679", "text": "Cảm ơn."}, {"start": "00:00:20.960", "end": "00:00:22.600", "text": "Tôi đang nói về một quả trứng chim."}, {"start": "00:00:22.600", "end": "00:00:23.640", "text": "Trứng này to thế."}, {"start": "00:00:23.640", "end": "00:00:25.679", "text": "Anh ta đang làm việc đấy."}, {"start": "00:00:25.679", "end": "00:00:27.280", "text": "Một cái cửa hàng thì không thể biến mất được."}, {"start": "00:00:27.280", "end": "00:00:28.039", "text": "Ồ, đó là..."}, {"start": "00:00:31.000", "end": "00:00:33.280", "text": "Mới đây, một bộ thiết bị mới đã được phát triển."}, {"start": "00:00:34.480", "end": "00:00:35.799", "text": "Đại úy Kawa ngày xưa."}]