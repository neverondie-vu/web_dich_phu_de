[{"start": "00:00:00.000", "end": "00:00:15.480", "text": "Cứ biết là chắc chắn rồi."}, {"start": "00:00:15.480", "end": "00:00:21.240", "text": "Opera"}, {"start": "00:00:21.240", "end": "00:00:25.039", "text": "Eddie."}, {"start": "00:00:25.839", "end": "00:00:26.880", "text": "Tôi sẽ làm vậy."}, {"start": "00:00:27.280", "end": "00:00:27.940", "text": "Thứ tư."}, {"start": "00:00:30.560", "end": "00:00:38.859", "text": "Quay lại."}, {"start": "00:00:40.380", "end": "00:00:41.079", "text": "Một cái khác."}]