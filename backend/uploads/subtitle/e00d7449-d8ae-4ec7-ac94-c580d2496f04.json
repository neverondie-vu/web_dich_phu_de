[{"start": "00:00:00.000", "end": "00:00:02.760", "text": "Giáp Đường bảo là tìm được một điểm đánh dấu khá ngon."}, {"start": "00:00:02.760", "end": "00:00:03.760", "text": "Chỗ đó nhiều \"mưa đen\" lắm."}, {"start": "00:00:03.760", "end": "00:00:05.440", "text": "Bữa trước tôi đã bỏ lỡ mấy con."}, {"start": "00:00:09.640", "end": "00:00:11.120", "text": "Có công thì phải có thưởng chứ."}, {"start": "00:00:11.120", "end": "00:00:12.120", "text": "Có một bức tường."}, {"start": "00:00:12.120", "end": "00:00:16.120", "text": "Đây là dòng của mấy anh em bên Sơn Đông."}, {"start": "00:00:16.120", "end": "00:00:17.679", "text": "Lần này \"nướng\" hơn rồi."}, {"start": "00:00:17.679", "end": "00:00:19.679", "text": "Cảm ơn."}, {"start": "00:00:20.960", "end": "00:00:22.600", "text": "Tôi đang nói về một quả trứng chim."}, {"start": "00:00:22.600", "end": "00:00:23.640", "text": "Quả trứng này to thế."}, {"start": "00:00:23.640", "end": "00:00:25.679", "text": "Ổng đang làm việc đó."}, {"start": "00:00:25.679", "end": "00:00:27.280", "text": "Một cái cửa hàng đâu có biến mất được."}, {"start": "00:00:27.280", "end": "00:00:28.039", "text": "Ồ, đó là..."}, {"start": "00:00:31.000", "end": "00:00:33.280", "text": "Gần đây, một bộ trang bị mới đã được phát triển."}, {"start": "00:00:34.480", "end": "00:00:35.799", "text": "Đại úy cũ của Kawa."}]