[{"start": "00:00:00.000", "end": "00:00:02.760", "text": "Giáp Đường bảo tìm được một điểm câu ngon rồi."}, {"start": "00:00:02.760", "end": "00:00:03.760", "text": "Ở đó có nhiều cá đen lắm."}, {"start": "00:00:03.760", "end": "00:00:05.440", "text": "Hôm trước tôi cũng đã thử vài bài ở đấy rồi."}, {"start": "00:00:09.640", "end": "00:00:11.120", "text": "Có công thì có hưởng."}, {"start": "00:00:11.120", "end": "00:00:12.120", "text": "Có một bức tường."}, {"start": "00:00:12.120", "end": "00:00:16.120", "text": "Đây là bài của dân câu Sơn Đông."}, {"start": "00:00:16.120", "end": "00:00:17.679", "text": "Đây là một pha ăn tiền."}, {"start": "00:00:17.679", "end": "00:00:19.679", "text": "Cảm ơn."}, {"start": "00:00:20.960", "end": "00:00:22.600", "text": "Tôi đang nói về một quả trứng chim."}, {"start": "00:00:22.600", "end": "00:00:23.640", "text": "Quả trứng này to thật đấy."}, {"start": "00:00:23.640", "end": "00:00:25.679", "text": "Cậu ấy đang làm kìa."}, {"start": "00:00:25.679", "end": "00:00:27.280", "text": "Cái này không thể thiếu được."}, {"start": "00:00:27.280", "end": "00:00:28.039", "text": "Ồ, ra là vậy."}, {"start": "00:00:31.000", "end": "00:00:33.280", "text": "Hôm nay, một bộ đồ nghề mới đã được phát triển."}, {"start": "00:00:34.480", "end": "00:00:35.799", "text": "Đại úy Kawa ngày xưa."}]