[{"start": "00:00:00.000", "end": "00:00:02.600", "text": "Với set đồ này, chúng ta đã tìm được một chỗ khá ngon."}, {"start": "00:00:03.000", "end": "00:00:04.080", "text": "Rất tự tin."}, {"start": "00:00:04.179", "end": "00:00:25.640", "text": "Có vài người đang câu cá ở đây."}, {"start": "00:00:26.039", "end": "00:00:27.960", "text": "Chúng ta có thể xử lý họ trước."}, {"start": "00:00:27.960", "end": "00:00:29.960", "text": "Hahahahaha"}, {"start": "00:00:31.080", "end": "00:00:33.240", "text": "Hôm nay tôi sẽ giới thiệu cho mọi người một thiết bị mới."}, {"start": "00:00:34.520", "end": "00:00:36.520", "text": "Của cựu Đại úy Kawa."}]