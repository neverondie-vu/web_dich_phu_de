[{"start": "00:00:00.000", "end": "00:00:02.760", "text": "Anh Giáp Đường bảo tìm được một điểm câu ngon rồi."}, {"start": "00:00:02.760", "end": "00:00:03.760", "text": "Ở đó có nhiều mực đen lắm."}, {"start": "00:00:03.760", "end": "00:00:05.440", "text": "Hôm trước tôi cũng đã thử mấy lần rồi."}, {"start": "00:00:09.640", "end": "00:00:11.120", "text": "Có làm thì mới có ăn chứ."}, {"start": "00:00:11.120", "end": "00:00:12.120", "text": "Có một cái tường."}, {"start": "00:00:12.120", "end": "00:00:16.120", "text": "Đây là kiểu chơi của mấy ông dân Sơn Đông."}, {"start": "00:00:16.120", "end": "00:00:17.679", "text": "Đây là một pha chơi lớn rồi."}, {"start": "00:00:17.679", "end": "00:00:19.679", "text": "Cảm ơn nhé."}, {"start": "00:00:20.960", "end": "00:00:22.600", "text": "Tôi đang nói về một quả trứng chim đó."}, {"start": "00:00:22.600", "end": "00:00:23.640", "text": "Trứng gì mà to thế không biết."}, {"start": "00:00:23.640", "end": "00:00:25.679", "text": "Anh ấy đang làm việc."}, {"start": "00:00:25.679", "end": "00:00:27.280", "text": "Một cái cửa hàng đâu thể tự nhiên biến mất được."}, {"start": "00:00:27.280", "end": "00:00:28.039", "text": "À, đó là..."}, {"start": "00:00:31.000", "end": "00:00:33.280", "text": "Hôm nay có một bộ đồ nghề mới ra lò."}, {"start": "00:00:34.480", "end": "00:00:35.799", "text": "Cựu đội trưởng Kawa."}]