[{"start": "00:00:00.000", "end": "00:00:02.760", "text": "Giáp Đường nói đã tìm thấy một chỗ đẹp."}, {"start": "00:00:02.760", "end": "00:00:03.760", "text": "Chỗ đó có nhiều cá đen."}, {"start": "00:00:03.760", "end": "00:00:05.440", "text": "Hôm trước, tôi đã câu được vài con rồi."}, {"start": "00:00:09.640", "end": "00:00:11.120", "text": "Có công làm thì có thưởng."}, {"start": "00:00:11.120", "end": "00:00:12.120", "text": "Có một bức tường."}, {"start": "00:00:12.120", "end": "00:00:16.120", "text": "Đây là dây câu của cần thủ Sơn Đông."}, {"start": "00:00:16.120", "end": "00:00:17.679", "text": "Lần này nướng kỹ hơn rồi."}, {"start": "00:00:17.679", "end": "00:00:19.679", "text": "Cảm ơn."}, {"start": "00:00:20.960", "end": "00:00:22.600", "text": "Tôi đang nói về một quả trứng chim."}, {"start": "00:00:22.600", "end": "00:00:23.640", "text": "Quả trứng này to ghê."}, {"start": "00:00:23.640", "end": "00:00:25.679", "text": "Anh ta đang làm việc."}, {"start": "00:00:25.679", "end": "00:00:27.280", "text": "Một cửa hàng không thể biến mất."}, {"start": "00:00:27.280", "end": "00:00:28.039", "text": "Ồ, đó là..."}, {"start": "00:00:31.000", "end": "00:00:33.280", "text": "Hiện tại, một bộ thiết bị mới đã được phát triển."}, {"start": "00:00:34.480", "end": "00:00:35.799", "text": "Cựu Đại úy Kawa."}]